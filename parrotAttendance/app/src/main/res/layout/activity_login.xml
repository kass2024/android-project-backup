<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="40dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <!-- APP TITLE -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Smart Attendance"
            android:textColor="#1A237E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- SUBTITLE -->
        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Secure • Accurate • Location Based"
            android:textColor="#455A64"
            android:textSize="14sp" />

        <!-- ===================== USERNAME FIELD ===================== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/input_background"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iconUser"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_edit" />

            <EditText
                android:id="@+id/inputUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iconUser"
                android:layout_marginStart="32dp"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:hint="Username"
                android:padding="8dp"
                android:textColor="#000"
                android:textColorHint="#757575"
                android:textSize="16sp" />
        </RelativeLayout>

        <!-- ===================== PASSWORD FIELD ===================== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_background"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iconLock"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_lock_idle_lock" />

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_toStartOf="@+id/btnTogglePassword"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:inputType="textPassword"
                android:hint="Password"
                android:padding="8dp"
                android:textColor="#000"
                android:textColorHint="#757575"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_eye_closed"
                android:padding="4dp" />
        </RelativeLayout>

        <!-- ===================== LOGIN BUTTON ===================== -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#1A237E"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <!-- ===================== LOADING ===================== -->
        <ProgressBar
            android:id="@+id/progressLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone" />

        <!-- ===================== FOOTER ===================== -->
        <TextView
            android:id="@+id/txtFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="© 2025 Parrot Smart Attendance. All Rights Reserved."
            android:textColor="#607D8B"
            android:textSize="12sp"
            android:paddingBottom="12dp" />

    </LinearLayout>

</ScrollView>
