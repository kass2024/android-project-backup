<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FFFFFF"/>

    <!-- Smooth rounded corners -->
    <corners android:radius="14dp"/>

    <!-- Soft border -->
    <stroke
        android:width="1dp"
        android:color="#C8CCD6"/>

    <!-- Inner spacing (prevents text from touching edges) -->
    <padding
        android:left="16dp"
        android:top="14dp"
        android:right="16dp"
        android:bottom="14dp"/>
</shape>
