<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET (API login, attendance submission) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- LOCATION PERMISSIONS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Background location (Optional but recommended for attendance apps) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Google Play Services -->
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParrotAttendance"
        tools:targetApi="34">

        <!-- 🔑 GOOGLE MAPS API KEY -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDE6Bq4mPbDMo0VEsVz3mKfUoqdRQlBtMQ" />

        <!-- 🚀 LOGIN SCREEN (Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- (Optional) Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- DASHBOARD -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- GOOGLE MAPS -->
        <activity
            android:name=".MapsActivity"
            android:exported="false" />

        <!-- ATTENDANCE HISTORY -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <!-- SALARY PAGE -->
        <activity
            android:name=".SalaryActivity"
            android:exported="false" />

        <!-- ⭐ CHECK-IN / CHECK-OUT ACTIVITY (IMPORTANT!) -->
        <activity
            android:name=".CheckInOutActivity"
            android:exported="false" />

    </application>

</manifest>
