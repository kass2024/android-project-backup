<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kiosk">

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_glow_cyan" />

    <LinearLayout
        android:id="@+id/idle_board"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp">

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_logo_frame"
                android:contentDescription="@string/app_name"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wisdom_logo" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_school_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#FF1D4ED8"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_school"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_location_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="Current mode:"
                    android:textColor="#FF93C5FD"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_chip"
                    android:paddingLeft="16dp"
                    android:paddingTop="5dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_clock_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="6dp"
                android:paddingTop="8dp"
                android:paddingRight="6dp"
                android:paddingBottom="10dp">

                <HorizontalScrollView
                    android:id="@+id/welcome_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tv_visit_welcome_depth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_marginTop="14dp"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="Welcome      ·      Welcome      ·      Please tap your visiting card      ·      Welcome      ·      Welcome      ·      Please tap your visiting card      ·      "
                            android:textColor="#FF08142C"
                            android:textSize="64sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_visit_welcome_shadow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:layout_marginTop="7dp"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="Welcome      ·      Welcome      ·      Please tap your visiting card      ·      Welcome      ·      Welcome      ·      Please tap your visiting card      ·      "
                            android:textColor="#FF2563EB"
                            android:textSize="64sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_visit_welcome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:shadowColor="#99FFFFFF"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="8"
                            android:singleLine="true"
                            android:text="Welcome      ·      Welcome      ·      Please tap your visiting card      ·      Welcome      ·      Welcome      ·      Please tap your visiting card      ·      "
                            android:textColor="#FFFFFFFF"
                            android:textSize="64sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tv_ready"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ready_chip"
                    android:letterSpacing="0.14"
                    android:paddingLeft="14dp"
                    android:paddingTop="3dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="3dp"
                    android:text="READY"
                    android:textColor="#FFBFDBFE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tv_clock_depth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="00:00:00"
                        android:textColor="#FF08142C"
                        android:textSize="72sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_clock_shadow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="00:00:00"
                        android:textColor="#FF2563EB"
                        android:textSize="72sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_clock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="3"
                        android:shadowRadius="12"
                        android:text="00:00:00"
                        android:textColor="#FFFFFFFF"
                        android:textSize="72sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.03"
                    android:textColor="#FFBFDBFE"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dock"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/scan_lamp_left"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginRight="14dp"
                    android:background="@drawable/bg_lamp_idle" />

                <FrameLayout
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:background="@drawable/bg_scan_frame"
                    android:padding="8dp">

                    <View
                        android:id="@+id/pulse_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_pulse_ring" />

                    <View
                        android:id="@+id/card_spot"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_card_spot" />

                    <TextView
                        android:id="@+id/tv_card_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:letterSpacing="0.1"
                        android:text="TAP"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <View
                    android:id="@+id/scan_lamp_right"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginLeft="14dp"
                    android:background="@drawable/bg_lamp_idle" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tap your student card"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_nfc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold the card at the bottom reader"
                android:textColor="#FF93C5FD"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_sync_pill"
                android:paddingLeft="12dp"
                android:paddingTop="3dp"
                android:paddingRight="12dp"
                android:paddingBottom="3dp"
                android:text="Online · synced"
                android:textColor="#FFBFDBFE"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_powered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1D4ED8"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/powered_by"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/bt_settings"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/bg_btn_ghost"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="Settings"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/result_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:gravity="fill"
        android:orientation="vertical"
        android:padding="0dp"
        android:visibility="invisible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/result_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_result_in"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="28dp"
                android:paddingRight="18dp"
                android:paddingBottom="28dp">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.xander.student.CircleImageView
                    android:id="@+id/img_photo"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.14"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="8"
                    android:text="WELCOME"
                    android:textColor="#FFFFFFFF"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="6dp"
                    android:maxLines="3"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="6dp"
                    android:maxLines="4"
                    android:textColor="#FFE0E7FF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_visit_students_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ready_chip"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:paddingLeft="16dp"
                    android:paddingTop="6dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="6dp"
                    android:text="STUDENTS TO VISIT"
                    android:textColor="#FFBBF7D0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/visit_students_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fillViewport="false"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/visit_students_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tv_visit_visitors_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:paddingLeft="16dp"
                    android:paddingTop="6dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="6dp"
                    android:text="ALLOWED VISITORS"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/visit_visitors_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/visit_visitors_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fee_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            android:layout_weight="1"
                            android:background="#33FFFFFF"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:letterSpacing="0.08"
                                android:text="SCHOOL FEES"
                                android:textColor="#FFBFDBFE"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_school_paid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="—"
                                android:textColor="#FFFFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_school_due"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="of —"
                                android:textColor="#FFE0E7FF"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"
                            android:background="#33FFFFFF"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:letterSpacing="0.08"
                                android:text="OTHER FEES"
                                android:textColor="#FFFDE68A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_extra_paid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="—"
                                android:textColor="#FFFFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_extra_due"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="of —"
                                android:textColor="#FFE0E7FF"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#44FFFFFF"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_promise_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.1"
                            android:text="NEXT PAYMENT PROMISED"
                            android:textColor="#FFBBF7D0"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_promise_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Checking…"
                            android:textColor="#FFFFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFFFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_visit_staff_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_visit_confirm"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp"
                    android:text=""
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <EditText
        android:id="@+id/et_nfc_wedge"
        android:layout_width="1px"
        android:layout_height="1px"
        android:background="@android:color/transparent"
        android:cursorVisible="false"
        android:imeOptions="actionDone"
        android:inputType="text|textNoSuggestions"
        android:maxLines="1" />
</FrameLayout>
