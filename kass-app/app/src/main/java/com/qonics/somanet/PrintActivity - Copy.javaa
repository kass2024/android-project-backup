    private void KeyListenerInit(boolean b) {
        amk = Hawk.get("infos_to_submit");
        btnScanButton = (Button) findViewById(R.id.button_scan);
        btnScanButton.setOnClickListener(this);

        cancel = (Button) findViewById(R.id.cancel);
