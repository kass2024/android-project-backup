<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internal cache directory: /data/data/<package>/cache -->
    <cache-path
        name="internal_cache"
        path="." />

    <!-- External cache directory: /storage/emulated/0/Android/data/<package>/cache -->
    <external-cache-path
        name="external_cache"
        path="." />

    <!-- App-specific Pictures directory: /storage/emulated/0/Android/data/<package>/files/Pictures -->
    <external-files-path
        name="pictures"
        path="Pictures" />

    <!-- Optional: Entire external files directory -->
    <external-files-path
        name="external_files"
        path="." />

</paths>
