<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".AttendanceActivity"
    tools:showIn="@layout/activity_attendance">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:padding="10dp"
        android:gravity="center"
        android:id="@+id/txtcount"
        android:textColor="@color/colorSuccess"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:visibility="visible"
        android:id="@+id/rlvloading">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_wait"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/prb"
            android:layout_marginTop="10dp"
            android:id="@+id/txtstatus"
            android:textSize="18dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:textColor="@color/main_blue_color"
            android:layout_alignParentBottom="true"
            android:id="@+id/txtretry"
            android:layout_centerHorizontal="true"
            android:textSize="18dp"
            android:text="@string/retry"/>
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:id="@+id/imgerror"
            android:src="@drawable/warning"
            android:visibility="invisible"
            android:tint="@color/main_orange_color"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:id="@+id/prb"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/lnlstudents">
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/main_green_stroke_color"
        android:layout_margin="@dimen/fab_margin"
        app:layout_anchor="@id/app_bar"
        app:fabCustomSize="70dp"
        app:maxImageSize="40dp"
        android:layout_gravity="center"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/ic_checked_mark" />
</LinearLayout>

</androidx.core.widget.NestedScrollView>