<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="96dp"
    android:fillViewport="true"
    android:id="@+id/scrollStudents"
    android:overScrollMode="always"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".AttendanceActivity"
    tools:showIn="@layout/activity_attendance">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:padding="10dp"
        android:gravity="center"
        android:id="@+id/txtcount"
        android:textColor="@color/colorSuccess"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#ffffff">
        <TextView
            android:id="@+id/btnDatePrev"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="&#8249;"
            android:textColor="#0EA5E9"
            android:textSize="28sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/txtAttendanceDate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="180dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0B1220"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />
        <TextView
            android:id="@+id/btnDateNext"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="&#8250;"
            android:textColor="#0EA5E9"
            android:textSize="28sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <androidx.appcompat.widget.SearchView
        android:id="@+id/srchstudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        app:iconifiedByDefault="false"
        app:queryHint="@string/atte_search_hint"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:visibility="visible"
        android:id="@+id/rlvloading">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_wait"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/prb"
            android:layout_marginTop="10dp"
            android:id="@+id/txtstatus"
            android:textSize="18dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:textColor="@color/main_blue_color"
            android:layout_alignParentBottom="true"
            android:id="@+id/txtretry"
            android:layout_centerHorizontal="true"
            android:textSize="18dp"
            android:text="@string/retry"/>
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:id="@+id/imgerror"
            android:src="@drawable/warning"
            android:visibility="invisible"
            android:tint="@color/main_orange_color"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:id="@+id/prb"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/lnlstudents">
    </LinearLayout>
</LinearLayout>

</androidx.core.widget.NestedScrollView>