<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TransportActivity">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10sp"
        android:text="@string/transport"
        android:textColor="@color/colorAccent"
        android:gravity="center"
        android:textSize="22dp"
        android:textStyle="bold"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorAccent"
        android:layout_marginBottom="10dp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_weight="1"
            android:padding="4dp"
            android:text="BUS: "
            android:id="@+id/txtbus"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:padding="4dp"
            android:text="PLACE: "
            android:id="@+id/txtplace"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:padding="4dp"
        android:text="ROUTE: "
        android:id="@+id/txtroute"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:padding="4dp"
        android:textSize="11dp"
        android:text="ROUTE DETAILS: "
        android:id="@+id/txtroutedetails"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/colorSuccess" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_weight="1"
            android:padding="4dp"
            android:layout_marginLeft="10dp"
            android:text="TOTAL STUDENTS: "
            android:id="@+id/txtstudents"/>
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:textStyle="bold"
            android:padding="4dp"
            android:textSize="20dp"
            android:textColor="#fff"
            android:gravity="center"
            android:background="@drawable/rounded_button_red"
            android:text="0"
            android:layout_marginRight="10dp"
            android:id="@+id/txtstcount"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="120dp"
        android:id="@+id/rlvnofitication"
        android:visibility="visible"
        >
        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/card"
            android:tint="@color/accent"
            android:id="@+id/imgcard"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/card"
            android:indeterminateTint="@color/accent"
            android:id="@+id/prb"
            android:indeterminate="true"
            android:layout_centerInParent="true"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:padding="4dp"
            android:textColor="@color/accent"
            android:layout_marginBottom="20dp"
            android:text="@string/tap_card"
            android:id="@+id/txtinfo"/>

    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/lnlstudent"
        android:visibility="gone"
        android:orientation="vertical">
        <ListView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:id="@+id/lvstudent"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X close"
            android:id="@+id/txtclose"
            android:textColor="#FF9800"
            android:padding="5dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center"/>
    </LinearLayout>
</LinearLayout>