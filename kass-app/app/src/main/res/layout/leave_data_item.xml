<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/logout"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="10dp"
    android:layout_margin="2dp"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_weight="1"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="18dp"
                android:text="Dally"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/reason"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="because of personal  issues"
                android:padding="5dp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sick leave"
                android:layout_alignParentRight="true"
                android:textColor="@color/colorPrimaryDark" />
            <TextView
                android:id="@+id/days"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="days"
                android:padding="2dp"/>
            <TextView
                android:id="@+id/status"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="#A22B06"
                android:text="Pending"
                android:padding="2dp"/>
        </LinearLayout>
    </LinearLayout>
<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="#cdcdcd"
    android:layout_marginTop="3dp"/>
    <LinearLayout
        android:layout_below="@id/reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="form"
            android:padding="2dp"/>
        <TextView
            android:id="@+id/dTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:padding="2dp"/>
        <TextView
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="address"
            android:padding="2dp"/>

    </LinearLayout>
    <TextView
        android:id="@+id/approver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="#334155" />
    <TextView
        android:id="@+id/gate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9a3412" />
    <LinearLayout
        android:id="@+id/leaveActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">
        <Button
            android:id="@+id/btnApprove"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="@string/leave_approve"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/btnDeny"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="@string/leave_deny"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>