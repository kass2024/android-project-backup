<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView android:id="@+id/txtReqNo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textStyle="bold" android:textSize="16sp" />
        <TextView android:id="@+id/txtReqStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#0A8FA7" />
        <TextView android:id="@+id/txtReqPayee" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/txtReqLine" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#666" android:textSize="12sp" />
        <TextView android:id="@+id/txtReqPurpose" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/txtReqAmount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textStyle="bold" />

        <LinearLayout android:id="@+id/lnlReqActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
