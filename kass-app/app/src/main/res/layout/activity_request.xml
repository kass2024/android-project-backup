<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/req_header"
        android:textColor="@color/colorAccent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/leave_gate_intro"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A8FA7"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:tint="@color/colorWhite"
            app:srcCompat="@drawable/info" />

        <TextView
            android:id="@+id/txtinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/colorWhite"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/staffBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/leave_staff"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/staffQuery"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_bg"
                    android:hint="@string/leave_search_hint"
                    android:inputType="textPersonName"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/staffPicked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/staff_hit_bg"
                    android:padding="12dp"
                    android:textColor="#166534"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/staffHits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/leave_type"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/lay_type"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:id="@+id/shortPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnHours"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/leave_few_hours"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btnDays"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/leave_few_days"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hoursBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/lay_date_from"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/field_bg"
                        android:focusable="false"
                        android:hint="@string/req_from"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/lay_time"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/field_bg"
                        android:focusable="false"
                        android:hint="@string/leave_start_time"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/leave_hours"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button android:id="@+id/chip1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="1 h" android:textAllCaps="false" />
                        <Button android:id="@+id/chip2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="2 h" android:textAllCaps="false" />
                        <Button android:id="@+id/chip3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="3 h" android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button android:id="@+id/chip4" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="4 h" android:textAllCaps="false" />
                        <Button android:id="@+id/chip6" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="6 h" android:textAllCaps="false" />
                        <Button android:id="@+id/chip8" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="8 h" android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/daysBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/shortDay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/field_bg"
                        android:focusable="false"
                        android:hint="@string/req_from"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button android:id="@+id/day1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="1 day" android:textAllCaps="false" />
                        <Button android:id="@+id/day2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="2 days" android:textAllCaps="false" />
                        <Button android:id="@+id/day3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="3 days" android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/regularPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/leave_days_requested"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/regDays"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_bg"
                    android:hint="@string/leave_days_requested"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/regFrom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/field_bg"
                    android:focusable="false"
                    android:hint="@string/req_from"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/regTo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/field_bg"
                    android:focusable="false"
                    android:hint="@string/req_to"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtReasonLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lbl_reason"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/lay_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/lbl_reason"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:padding="12dp"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/leave_cover_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/coverQuery"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/leave_cover_hint"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/coverPicked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="8dp"
                android:textColor="#166534"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/coverHits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/leave_cover_phone_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/coverPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="07..."
                android:inputType="phone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/leave_cover_sms"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtLeaveNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/leave_certificate_note"
                android:textColor="#92400E"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/leave_address_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/lay_address"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/leave_address_hint"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="#166534" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="12dp"
        android:background="@drawable/save"
        android:text="@string/leave_save_changes"
        android:textAllCaps="false"
        android:textColor="#fff"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/prb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />
</LinearLayout>
