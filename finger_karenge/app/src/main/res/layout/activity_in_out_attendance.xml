<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0099cc"
    android:orientation="vertical"
    android:keepScreenOn="true"
    android:id="@+id/fullscreen_content"
    tools:context="com.qonics.somanet_attendance.MainActivity">


    <LinearLayout
        android:id="@+id/topLineLayout"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#333333"
        android:orientation="vertical"
        tools:ignore="UselessParent"
        android:paddingTop="40dp"
        android:gravity="center_horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_txtinfo2"
            android:id="@+id/textView1"
            android:textColor="#ffffff"
            android:textSize="24dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_txtinfo3"
            android:id="@+id/textView2"
            android:textColor="#ffffff"
            android:textSize="48dp" />

    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#ffffff"
        android:layout_weight="1"
        android:text="Welcome"
        android:textSize="40dp"
        android:visibility="gone"
        android:id="@+id/txtinfo"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1"
        android:id="@+id/lnlstaff">
        <ImageView
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:src="@drawable/placeholder_image"
            android:layout_gravity="center"
            android:id="@+id/img_profile"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#ffffff"
            android:text="SHEMA Ally Blaise"
            android:textSize="30dp"
            android:id="@+id/txtname"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#ffffff"
            android:text="Type:"
            android:textSize="25dp"
            android:id="@+id/txttype"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#ffffff"
            android:text="Class:"
            android:textSize="25dp"
            android:id="@+id/txtother"
            />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#ffffff"
        android:text="Tap student card"
        android:textSize="15dp"
        android:layout_marginBottom="20dp"
        android:id="@+id/tvFpStatus"
        />
</LinearLayout>
